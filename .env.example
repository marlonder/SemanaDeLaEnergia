# Puertos expuestos en tu máquina (host)
APP_PORT=8080
DB_PORT=3306
PMA_PORT=8081

# Credenciales de la base de datos
DB_DATABASE=complexivo
DB_USERNAME=complexivo_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# UID/GID de tu usuario en Linux (evita problemas de permisos)
# Ejecuta en tu terminal: id -u   y   id -g
UID=1000
GID=1000
